		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.0.0",
		"@types/sanitize-html": "^2.16.0",
		"autoprefixer": "^10.4.20",
		"bits-ui": "^1.3.0",
		"clsx": "^2.1.1",
		"daisyui": "^4.12.24",
		"eslint": "^9.20.0",
